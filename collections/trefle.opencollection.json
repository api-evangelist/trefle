    {
      "info": {
        "name": "Genus",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Genus",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://trefle.io/api/v1/genus",
            "params": [
              {
                "name": "page",
