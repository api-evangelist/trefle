        }
      ]
    },
    {
      "info": {
        "name": "Families",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Families",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://trefle.io/api/v1/families",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a paginated list of plant families with taxonomy hierarchy data."
        },
