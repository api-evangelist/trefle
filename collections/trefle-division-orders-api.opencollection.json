{
  "opencollection": "1.0.0",
  "info": {
    "name": "Trefle Distributions Division Orders API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "token",
      "value": "{{token}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Division Orders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Division Orders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://trefle.io/api/v1/division_orders"
          },
          "docs": "Returns a list of botanical division orders."
        }
      ]
    }
  ],
  "bundled": true
}