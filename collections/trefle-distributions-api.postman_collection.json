          "name": "Get Plants by Distribution",
          "request": {
            "name": "Get Plants by Distribution",
            "description": {
              "content": "Retrieves plants native or established in a specific geographic distribution zone. Can be filtered by establishment type (native, introduced, etc.).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "distributions",
                ":id",
                "plants"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "filter[establishment]",
                  "value": "<string>",
                  "description": "Filter by establishment type in the distribution zone"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) Distribution zone slug or ID (e.g., tibet, california, france)"
